# Token da API 2.0 do Olist ERP (Tiny) — gerado em ERP Olist > Configurações > Token API.
# Não expira sozinho; só é preciso trocar se for revogado/regenerado manualmente.
OLIST_API_TOKEN=

# Base da API v2 do Tiny/Olist — normalmente não precisa alterar.
# OLIST_API_BASE_URL=https://api.tiny.com.br/api2

# Formato de resposta usado nas chamadas.
# OLIST_API_FORMAT=json

# A cada quanto tempo o servidor busca os números de verdade no Olist (ms).
# Padrão 30s (igual ao polling da tela) pra ficar o mais "ao vivo" possível.
# CUIDADO ao baixar mais: a API do Tiny tem limite de taxa. Se começar a dar
# erro de limite excedido, a solução é subir esse número.
# OLIST_SYNC_INTERVAL_MS=30000

# Porta do servidor Express.
# PORT=4000

# Onde o último snapshot sincronizado fica salvo (arquivo JSON).
# Em produção (Render), aponte para o mount path de um Persistent Disk —
# senão o cache zera a cada redeploy (o painel só mostra "esqueleto" até a
# próxima sincronização, nada mais grave que isso).
# DATA_DIR=./data

# --- Só necessário se o front (Vercel) e a API (Render) rodarem em domínios
# separados. Rodando os dois juntos (um único Express, como em dev), pode
# ignorar as duas variáveis abaixo. ---

# URL(s) do front que podem chamar esta API (separe por vírgula se tiver mais
# de uma, ex: preview + produção da Vercel). Sem isso, o navegador bloqueia a
# chamada por CORS quando front e API não são o mesmo domínio.
# CORS_ORIGIN=https://seu-painel.vercel.app

# Configurada no projeto da Vercel (Settings > Environment Variables), não
# aqui — é lida em build-time pelo Vite, então precisa existir ANTES do build.
# VITE_API_URL=https://seu-servico.onrender.com
