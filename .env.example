# Token da API 2.0 do Olist ERP (Tiny) — gerado em ERP Olist > Configurações > Token API.
# Não expira sozinho; só é preciso trocar se for revogado/regenerado manualmente.
OLIST_API_TOKEN=

# Base da API v2 do Tiny/Olist — normalmente não precisa alterar.
# OLIST_API_BASE_URL=https://api.tiny.com.br/api2

# Formato de resposta usado nas chamadas.
# OLIST_API_FORMAT=json

# Quantos dias pra tras (por dataCriacao) a busca de "Embaladas" olha, pra achar
# itens que podem ter sido embalados hoje. Quanto maior, menos itens "antigos"
# escapam da contagem (menos divergencia com a tela do Olist), mas mais paginas
# por sync — cada pagina=100 registros, e ha um teto de seguranca de 40 paginas
# (a contagem falha isolada nesse caso e mantem o ultimo valor em cache, sem
# afetar as outras 3 etapas). Com o volume tipico visto nos testes (~6-7
# paginas/dia), 6 dias fica dentro do teto com folga.
# OLIST_EMBALADAS_WINDOW_DAYS=6

# A cada quanto tempo o servidor busca os números de verdade no Olist (ms).
# Padrão 30s (igual ao polling da tela) pra ficar o mais "ao vivo" possível —
# vale só pra Aguardando/Em separação/Separadas (ver OLIST_EMBALADAS_SYNC_INTERVAL_MS
# pro Embaladas, que sincroniza separado). CUIDADO ao baixar mais: a API do
# Tiny tem limite de taxa. Se começar a dar erro de limite excedido, a solução
# é subir esse número.
# OLIST_SYNC_INTERVAL_MS=30000

# A cada quanto tempo o servidor busca o número de "Embaladas" (ms) — separado
# do resto de propósito: depois que um item sai de "Separadas" só tem um
# caminho possível (virar "Embaladas"), então não precisa ser tão ao vivo, e
# cada sync dela custa várias páginas (proporcional à janela de dias acima).
# Rodar junto com o sync de 30s é o que estourou o rate limit do Tiny na
# prática ("Token inválido" numa rajada de ~20 páginas). Padrão 10min.
# OLIST_EMBALADAS_SYNC_INTERVAL_MS=600000

# Porta do servidor Express.
# PORT=4000

# Onde o último snapshot sincronizado fica salvo (arquivo JSON).
# Em produção (Render), aponte para o mount path de um Persistent Disk —
# senão o cache zera a cada redeploy (o painel só mostra "esqueleto" até a
# próxima sincronização, nada mais grave que isso).
# DATA_DIR=./data

# --- Só necessário se o front (Vercel) e a API (Render) rodarem em domínios
# separados. Rodando os dois juntos (um único Express, como em dev), pode
# ignorar as duas variáveis abaixo. ---

# URL(s) do front que podem chamar esta API (separe por vírgula se tiver mais
# de uma, ex: preview + produção da Vercel). Sem isso, o navegador bloqueia a
# chamada por CORS quando front e API não são o mesmo domínio.
# CORS_ORIGIN=https://seu-painel.vercel.app

# Configurada no projeto da Vercel (Settings > Environment Variables), não
# aqui — é lida em build-time pelo Vite, então precisa existir ANTES do build.
# VITE_API_URL=https://seu-servico.onrender.com

# --- Importação Shopee (aba Devoluções) ---

# Senha própria (não é o token do Tiny) que o Tampermonkey manda no header
# x-import-token pra POST /api/devolucao/shopee. Sem isso configurado, essa
# rota recusa qualquer requisição — gere uma string aleatória qualquer e use
# a mesma no script do Tampermonkey (ver tampermonkey/devolucao-shopee.user.js).
# SHOPEE_IMPORT_TOKEN=
